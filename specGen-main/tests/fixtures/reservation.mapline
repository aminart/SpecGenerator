        "activities": {
          "cfx3z5n0:wqvi9est": {
            "id": "r10gomid",
            "text": "Cherche un praticien disponible près de chez lui"
          },
          "cfx3z5n0:3iq3h76g": {
            "id": "vpvcnqay",
            "text": "Choisit un créneau"
          },
          "cfx3z5n0:l73biime": {
            "id": "7vzfj01h",
            "text": "Renseigne ses informations"
          },
          "cfx3z5n0:c0g8aohq": {
            "id": "x8ynh5bm",
            "text": "Reçoit un SMS de confirmation"
          },
          "cfx3z5n0:4lydk3oc": {
            "id": "yiymhyt9",
            "text": "Se présente au cabinet"
          },
          "cfx3z5n0:w4uvq40f": {
            "id": "e4goj7b4",
            "text": "Reçoit son compte-rendu"
          },
          "hqqmto1c:l73biime": {
            "id": "xmcpi8j9",
            "text": "Valide la demande de rendez-vous"
          },
          "hqqmto1c:c0g8aohq": {
            "id": "6w7t667t",
            "text": "Envoie un rappel la veille"
          },
          "hqqmto1c:4lydk3oc": {
            "id": "rfjxcvjm",
            "text": "Accueille le patient"
          },
          "rciph895:4lydk3oc": {
            "id": "d8it2wvb",
            "text": "Consulte le motif et le dossier"
          },
          "rciph895:w4uvq40f": {
            "id": "wqer098a",
            "text": "Rédige le compte-rendu"
          }
        },
